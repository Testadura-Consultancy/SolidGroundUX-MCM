    "$SGND_SOLIDGROUND_MANAGEMENT_CONSOLE_MODULES_PRODUCT" \
    "$SGND_SOLIDGROUND_MANAGEMENT_CONSOLE_MODULES_VERSION" \
    "$SGND_SOLIDGROUND_MANAGEMENT_CONSOLE_MODULES_BUILD" \
    "$RESET"


